# Database
DATABASE_URL=postgresql://user:password@localhost:5432/medical_attendance

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:5000

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# AI SERVICES - Choose your preferred AI providers

# OpenAI (GPT-4)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Gemini (Vision + General)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key

# LangChain Configuration
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_TRACING=true

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
ALLOWED_FORMATS=pdf,jpg,jpeg,png,xlsx,xls,csv,doc,docx

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# AI Feature Flags
ENABLE_TIMETABLE_AI=true
ENABLE_ATTENDANCE_AI=true
ENABLE_NLP_CHAT=true
ENABLE_FACIAL_RECOGNITION=true
ENABLE_PREDICTIVE_ANALYTICS=true
ENABLE_AUTO_SYNC=true

# Logging & Monitoring
LOG_LEVEL=debug
SENTRY_DSN=your_sentry_dsn

# Flask AI Service
FLASK_ENV=development
FLASK_DEBUG=1
